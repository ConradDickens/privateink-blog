## Hardhat 任务

参考 [FHECounter.ts](mdc:fhevm-hardhat-template/tasks/FHECounter.ts)

### 创建任务
```typescript
import { task } from "hardhat/config";

task("vote", "Cast an encrypted vote")
  .addParam("value", "Vote value")
  .setAction(async (taskArgs, hre) => {
    const contract = await hre.ethers.getContract("VotingContract");
    const [signer] = await hre.ethers.getSigners();
    
    // 加密投票值
    const { createInstance } = await import("@fhevm/mock-utils");
    const instance = await createInstance(signer, hre.ethers, contract);
    
    const input = instance.createEncryptedInput(
      await contract.getAddress(),
      signer.address
    );
    input.add32(parseInt(taskArgs.value));
    const encrypted = input.encrypt();
    
    // 提交投票
    const tx = await contract.vote(encrypted.handles[0], encrypted.inputProof);
    await tx.wait();
    
    console.log("Vote cast successfully!");
  });
```

### 运行任务
```bash
npx hardhat vote --value 1 --network localhost
```

