# 智能合约开发规则

## 合约基本结构

参考 [FHECounter.sol](mdc:fhevm-hardhat-template/contracts/FHECounter.sol)

### 必需导入
```solidity
// SPDX-License-Identifier: MIT
pragma solidity ^0.8.24;

import "@fhevm/solidity/lib/FHE.sol";
import "@fhevm/solidity/config/ZamaConfig.sol";
```

### 网络配置继承
```solidity
// 本地测试
contract MyContract is ZamaConfig { }

// Sepolia 测试网
contract MyContract is SepoliaConfig { }

// 以太坊主网
contract MyContract is EthereumConfig { }
```

### 基本合约模板
```solidity
contract VotingContract is SepoliaConfig {
    // 状态变量
    euint32 private encryptedVoteCount;
    mapping(address => ebool) public hasVoted;
    
    // 事件
    event VoteCast(address indexed voter);
    
    // 构造函数
    constructor() {
        encryptedVoteCount = FHE.asEuint32(0);
        FHE.allowThis(encryptedVoteCount);
    }
    
    // 核心功能
    function vote(inEuint32 calldata encryptedVote) public {
        require(!FHE.decrypt(hasVoted[msg.sender]), "Already voted");
        
        euint32 vote = FHE.asEuint32(encryptedVote);
        encryptedVoteCount = FHE.add(encryptedVoteCount, vote);
        
        hasVoted[msg.sender] = FHE.asEbool(true);
        
        FHE.allowThis(encryptedVoteCount);
        FHE.allow(encryptedVoteCount, msg.sender);
        
        emit VoteCast(msg.sender);
    }
    
    // 查询功能
    function getVoteCount() public view returns (euint32) {
        require(FHE.isSenderAllowed(encryptedVoteCount), "Not authorized");
        return encryptedVoteCount;
    }
}
```

## 访问控制最佳实践

### 授权模式

**永久授权**：
```solidity
FHE.allow(encryptedValue, userAddress);  // 用户可随时解密
FHE.allowThis(encryptedValue);           // 合约可访问
```

**临时授权**：
```solidity
FHE.allowTransient(encryptedValue, userAddress);  // 仅当前交易有效
```

### 权限检查
```solidity
modifier onlyAllowed(euint32 value) {
    require(FHE.isSenderAllowed(value), "Not authorized");
    _;
}

function sensitiveOperation(euint32 value) public onlyAllowed(value) {
    // 安全操作
}
```

## 部署脚本

参考 [deploy.ts](mdc:fhevm-hardhat-template/deploy/deploy.ts)

### 标准部署脚本
```typescript
import { HardhatRuntimeEnvironment } from "hardhat/types";
import { DeployFunction } from "hardhat-deploy/types";

const func: DeployFunction = async function (hre: HardhatRuntimeEnvironment) {
  const { deployer } = await hre.getNamedAccounts();
  const { deploy } = hre.deployments;

  await deploy("VotingContract", {
    from: deployer,
    args: [],  // 构造函数参数
    log: true,
    waitConfirmations: 1,
  });
};

export default func;
func.tags = ["VotingContract"];
func.dependencies = [];  // 如有依赖合约
```

### 部署命令
```bash
# 本地部署
npx hardhat deploy --network localhost

# Sepolia 部署
npx hardhat deploy --network sepolia

# 仅部署特定合约
npx hardhat deploy --tags VotingContract --network localhost
```

## 测试规范

### 本地测试

参考 [FHECounter.ts](mdc:fhevm-hardhat-template/test/FHECounter.ts)

```typescript
import { expect } from "chai";
import { ethers, deployments } from "hardhat";
import { createInstances } from "@fhevm/mock-utils";

describe("VotingContract", function () {
  let contract: any;
  let instances: any;
  let alice: any, bob: any;

  beforeEach(async function () {
    await deployments.fixture(["VotingContract"]);
    [alice, bob] = await ethers.getSigners();
    
    contract = await ethers.getContract("VotingContract");
    instances = await createInstances([alice, bob], ethers, contract);
  });

  it("should allow voting", async function () {
    const input = instances.alice.createEncryptedInput(
      await contract.getAddress(),
      alice.address
    );
    input.add32(1);
    const encryptedVote = input.encrypt();

    await contract.connect(alice).vote(
      encryptedVote.handles[0],
      encryptedVote.inputProof
    );

    // 验证事件
    await expect(tx).to.emit(contract, "VoteCast");
  });

  it("should prevent double voting", async function () {
    // 第一次投票
    const input = instances.alice.createEncryptedInput(
      await contract.getAddress(),
      alice.address
    );
    input.add32(1);
    const encryptedVote = input.encrypt();
    
    await contract.connect(alice).vote(
      encryptedVote.handles[0],
      encryptedVote.inputProof
    );

    // 第二次应失败
    await expect(
      contract.connect(alice).vote(
        encryptedVote.handles[0],
        encryptedVote.inputProof
      )
    ).to.be.revertedWith("Already voted");
  });
});
```

